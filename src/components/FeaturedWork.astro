---
import Icon from "./Icon.astro";
import { featuredWork } from "../data/content.js";

// Portrait clips go in the tilted 4-column row; landscape clips get their own row below.
const portrait = featuredWork.videos.filter((v) => v.orientation !== "landscape");
const landscape = featuredWork.videos.filter((v) => v.orientation === "landscape");

const offsets = [
  "rotate-1 md:rotate-2 lg:rotate-3 -mt-8 md:-mt-12 lg:-mt-16",
  "-rotate-1 md:-rotate-2 lg:-rotate-3 mt-2 md:mt-4 lg:mt-6",
  "rotate-1 md:rotate-2 lg:rotate-3 mt-2 md:mt-4 lg:mt-6",
  "-rotate-1 md:-rotate-2 lg:-rotate-3 -mt-8 md:-mt-12 lg:-mt-16",
];

// Centre a short last row on the 4-column layout: 2 cards start at column 2;
// a single card spans the middle two columns.
const rem = portrait.length % 4;
const lastRowClass = (i) =>
  rem === 2 && i === portrait.length - 2
    ? "lg:col-start-2"
    : rem === 1 && i === portrait.length - 1
      ? "lg:col-start-2 lg:col-span-2 lg:justify-self-center lg:w-[calc(50%-2rem)]"
      : "";

const cardBase =
  "bg-black rounded-lg md:rounded-xl lg:rounded-2xl overflow-hidden shadow-lg border-2 md:border-4 border-black reveal relative";
---
<section id="featured-work" class="py-12 md:py-20 mb-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12 md:mb-16 reveal">
      <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold mb-4 md:mb-6 cinzel px-4">
        {featuredWork.heading}
      </h2>
      <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto px-4">{featuredWork.subtitle}</p>
    </div>

    <!-- portrait row -->
    <div class="w-full flex justify-center">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-12 lg:gap-16 max-w-7xl">
        {
          portrait.map((v, i) => (
            <div
              class:list={[
                cardBase,
                "aspect-[9/16] flex flex-col items-center justify-center max-w-sm md:max-w-md lg:max-w-lg",
                offsets[i % offsets.length],
                lastRowClass(i),
              ]}
            >
              <video
                src={v.src}
                poster={v.poster}
                class="w-full h-full object-cover"
                autoplay
                muted
                loop
                playsinline
                controls
                preload="metadata"
                style="aspect-ratio: 9 / 16;"
              />
              {v.ai && (
                <span class="absolute top-2 left-2 z-10 pointer-events-none rounded-full bg-black/75 text-white text-[10px] font-semibold tracking-wider px-2.5 py-1 border border-white/30">
                  AI
                </span>
              )}
            </div>
          ))
        }
      </div>
    </div>

    <!-- landscape row -->
    {landscape.length > 0 && (
      <div class="mt-16 md:mt-24 grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-5xl mx-auto">
        {landscape.map((v, i) => (
          <div
            class:list={[
              cardBase,
              "aspect-video",
              i % 2 === 0 ? "md:rotate-1" : "md:-rotate-1",
            ]}
          >
            <video
              src={v.src}
              poster={v.poster}
              class="w-full h-full object-cover"
              autoplay
              muted
              loop
              playsinline
              controls
              preload="metadata"
            />
            {v.ai && (
              <span class="absolute top-2 left-2 z-10 pointer-events-none rounded-full bg-black/75 text-white text-[10px] font-semibold tracking-wider px-2.5 py-1 border border-white/30">
                AI
              </span>
            )}
          </div>
        ))}
      </div>
    )}

    <div class="text-center mt-14 reveal">
      <a
        href={featuredWork.viewAllHref}
        class="inline-flex items-center text-lg font-semibold text-gray-800 hover:text-gray-600 transition-colors"
      >
        {featuredWork.viewAllText}
        <Icon name="arrow-right" class="w-5 h-5 ml-2" />
      </a>
    </div>
  </div>
</section>

<script>
  // Featured Work clips play muted and loop. Only clips near the viewport play,
  // so ten videos never decode at once; they pause when scrolled far away.
  const vids = Array.from(document.querySelectorAll("#featured-work video[autoplay]"));

  function play(v) {
    v.muted = true;
    const p = v.play();
    if (p) p.catch(() => {});
  }

  // If the browser blocked autoplay, retry once on the first tap/click.
  window.addEventListener(
    "pointerdown",
    () => vids.forEach((v) => v.paused && v.getBoundingClientRect().top < window.innerHeight * 2 && play(v)),
    { once: true }
  );

  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? play(e.target) : e.target.pause()));
      },
      { rootMargin: "60% 0px 60% 0px" }
    );
    vids.forEach((v) => io.observe(v));
  } else {
    vids.forEach(play);
  }
</script>
