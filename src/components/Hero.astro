---
import Icon from "./Icon.astro";
import { hero, site } from "../data/content.js";
---
<div id="hero">
  <div class="relative min-h-screen w-full flex items-center justify-center overflow-hidden bg-[#030303]">
    <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/[0.05] via-transparent to-rose-500/[0.05] blur-3xl"></div>

    <!-- decorative glass pills -->
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute left-[-10%] md:left-[-5%] top-[15%] md:top-[20%] hidden md:block rotate-12">
        <div class="w-[600px] h-[140px] rounded-full bg-gradient-to-r to-transparent from-indigo-500/[0.15] backdrop-blur-[2px] border-2 border-white/[0.15] shadow-[0_8px_32px_0_rgba(255,255,255,0.1)]"></div>
      </div>
      <div class="absolute right-[-5%] md:right-0 top-[70%] md:top-[75%] hidden md:block -rotate-[15deg]">
        <div class="w-[500px] h-[120px] rounded-full bg-gradient-to-r to-transparent from-rose-500/[0.15] backdrop-blur-[2px] border-2 border-white/[0.15] shadow-[0_8px_32px_0_rgba(255,255,255,0.1)]"></div>
      </div>
      <div class="absolute left-[5%] md:left-[10%] bottom-[5%] md:bottom-[10%] hidden md:block -rotate-[8deg]">
        <div class="w-[300px] h-[80px] rounded-full bg-gradient-to-r to-transparent from-violet-500/[0.15] backdrop-blur-[2px] border-2 border-white/[0.15] shadow-[0_8px_32px_0_rgba(255,255,255,0.1)]"></div>
      </div>
    </div>

    <div class="relative z-10 container mx-auto px-4 md:px-6 pt-24 pb-12 lg:pt-20">
      <div class="grid lg:grid-cols-2 items-center gap-10 lg:gap-8 max-w-6xl mx-auto">
        <!-- the character -->
        {site.character && (
          <div class="order-1 lg:order-2 flex justify-center">
            <div class="relative w-60 sm:w-72 lg:w-[26rem]">
              <div class="absolute -inset-6 rounded-[2.5rem] bg-gradient-to-br from-indigo-500/25 via-transparent to-rose-500/25 blur-2xl"></div>
              <img
                src={site.character}
                alt={`${site.name} - 3D portrait`}
                width="720"
                height="900"
                fetchpriority="high"
                class="relative w-full h-auto rounded-[2rem] border border-white/15 shadow-2xl"
              />
            </div>
          </div>
        )}

      <div class="order-2 lg:order-1 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.03] border border-white/[0.08] mb-6 md:mb-8">
          <Icon name="circle" class="h-2 w-2 fill-rose-500/80 text-rose-500/80" />
          <span class="text-xs md:text-sm text-white/60 tracking-wide">{hero.badge}</span>
        </div>

        <h1 class="text-2xl sm:text-4xl md:text-6xl lg:text-6xl font-bold mb-4 md:mb-8 tracking-tight px-2 sm:px-4 lg:px-0 leading-tight">
          <span class="bg-clip-text text-transparent bg-gradient-to-b from-white to-white/80 text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold">{hero.lineTop}</span>
          <br />
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-indigo-300 via-white/90 to-[#F8F6D0] text-2xl sm:text-4xl md:text-6xl lg:text-6xl xl:text-7xl font-bold whitespace-nowrap">{hero.lineMid}</span>
          <span class="block mt-3 md:mt-4 leading-snug bg-clip-text text-transparent bg-gradient-to-b from-white to-white/80 text-lg sm:text-xl md:text-2xl lg:text-xl xl:text-2xl font-bold">{hero.lineBottom}</span>
        </h1>

        <div class="flex justify-center lg:justify-start">
          <a
            href={hero.ctaHref}
            class="bg-gradient-to-r from-[#405060] via-[#A0B0C0] to-[#FFFACD] text-black px-6 md:px-12 py-3 md:py-4 rounded-lg font-semibold hover:from-[#506070] hover:via-[#B0C0D0] hover:to-[#FFF8DC] transition-all duration-300 flex items-center justify-center backdrop-blur-md text-sm md:text-base shadow-lg hover:shadow-xl cursor-pointer"
          >
            {hero.ctaText}
            <Icon name="arrow-right" class="w-4 h-4 md:w-5 md:h-5 ml-2" />
          </a>
        </div>
      </div>
      </div>
    </div>

    <div class="absolute inset-0 bg-gradient-to-t from-[#030303] via-transparent to-[#030303]/80 pointer-events-none"></div>
  </div>
</div>
