---
// One work clip. orientation: "portrait" (9:16) or "landscape" (16:9).
// ai: true adds an "AI" badge so AI-generated work is clearly labelled.
const { src, poster, title, orientation = "portrait", ai = false } = Astro.props;
const isLandscape = orientation === "landscape";
---
<figure class:list={["w-full", isLandscape ? "max-w-md" : "max-w-[240px]"]}>
  <div
    class:list={[
      isLandscape ? "aspect-video" : "aspect-[9/16]",
      "relative rounded-xl overflow-hidden bg-black border-2 border-black shadow-md",
    ]}
  >
    <video
      src={src}
      poster={poster}
      class="w-full h-full object-cover"
      controls
      preload="none"
      playsinline
    ></video>
    {ai && (
      <span class="absolute top-2 left-2 z-10 pointer-events-none rounded-full bg-black/75 text-white text-[10px] font-semibold tracking-wider px-2.5 py-1 border border-white/30">
        AI
      </span>
    )}
  </div>
  <figcaption class="mt-2 text-sm text-gray-600">
    {title}{ai && <span class="text-gray-400"> · AI generated</span>}
  </figcaption>
</figure>
