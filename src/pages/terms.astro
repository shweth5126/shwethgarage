---
import LegalLayout from "../components/LegalLayout.astro";
import { site, contact } from "../data/content.js";
---
<LegalLayout title="Terms & Conditions" updated="October 2026">
  <p>These terms cover use of this website and enquiries made through it.</p>

  <h2>Use of this site</h2>
  <p>
    Videos, images and text on this site belong to {site.name} or the clients
    credited, and may not be reused without permission.
  </p>

  <h2>Enquiries and quotes</h2>
  <p>
    Sending the contact form does not create a contract. Any quote, scope,
    timeline and price is confirmed separately in writing before work begins.
  </p>

  <h2>Project work</h2>
  <p>
    Deliverables, revision rounds, payment terms and usage rights are agreed per
    project. Turnaround times and prices shown on this site are guidelines and
    may change with the scope of the work.
  </p>

  <h2>Liability</h2>
  <p>
    This site is provided as is. No liability is accepted for losses arising from
    its use or from relying on its content.
  </p>

  <h2>Contact</h2>
  <p>
    Questions about these terms: <a href={`mailto:${contact.email}`}>{contact.email}</a>.
  </p>
</LegalLayout>
